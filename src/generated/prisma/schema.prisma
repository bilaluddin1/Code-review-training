// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ChallengeLock {
  id     String  @id
  locked Boolean
}

model LeaderboardUser {
  id        String   @id @default(uuid())
  name      String   @unique
  avatar    String
  score     Int
  updatedAt DateTime @default(now()) @updatedAt
}

model ChallengeSubmission {
  id            String   @id @default(uuid())
  userName      String
  challengeId   String
  selectedLines String // stores JSON array as string
  correct       Boolean
  createdAt     DateTime @default(now())
}

model FlagSubmission {
  id          String   @id @default(uuid())
  userName    String
  challengeId String
  flag        String
  correct     Boolean
  createdAt   DateTime @default(now())
}

// A frozen snapshot of the leaderboard, taken right before "Reset Everything"
// wipes it. Lets each product team's session results be kept and exported
// (CSV) even after the next team's session resets the live leaderboard.
model SessionArchive {
  id         String   @id @default(uuid())
  sessionId  String // groups the rows taken in one archive call together
  teamName   String
  archivedAt DateTime @default(now())
  userName   String
  avatar     String
  score      Int

  @@index([sessionId])
}
