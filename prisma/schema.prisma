// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ChallengeLock {
  id        String @id
  locked    Boolean
}

model LeaderboardUser {
  id        String @id @default(uuid())
  name      String @unique
  avatar    String
  score     Int
  updatedAt DateTime @default(now()) @updatedAt
}

model ChallengeSubmission {
  id        String   @id @default(uuid())
  userName  String
  challengeId String
  selectedLines String // stores JSON array as string
  correct   Boolean
  createdAt DateTime @default(now())
}

model FlagSubmission {
  id          String   @id @default(uuid())
  userName    String
  challengeId String
  flag        String
  correct     Boolean
  createdAt   DateTime @default(now())
}

// A frozen snapshot of the leaderboard, taken right before "Reset Everything"
// wipes it. Lets each product team's session results be kept and exported
// (CSV) even after the next team's session resets the live leaderboard.
model SessionArchive {
  id         String   @id @default(uuid())
  sessionId  String   // groups the rows taken in one archive call together
  teamName   String
  archivedAt DateTime @default(now())
  userName   String
  avatar     String
  score      Int

  @@index([sessionId])
}

// Submitted by devs themselves via the "Give Feedback" button, any time -
// not gated on finishing every lab. teamName is derived server-side from
// FeedbackToggle.currentTeam at submit time, not typed by the dev.
// Ratings live in FeedbackAnswer (one row per question answered), NOT as
// fixed columns here - so questions can be added/removed/reworded via the
// admin UI with no further schema changes, ever.
model FeedbackResponse {
  id                String           @id @default(uuid())
  userName          String
  teamName          String?
  comments          String?
  createdAt         DateTime         @default(now())
  answers           FeedbackAnswer[]
  // Set together with the leaderboard's SessionArchive.sessionId, by the
  // same "Archive + Reset" action, so a response stops showing in the live
  // Dev Feedback panel once its session is archived, the same way
  // LeaderboardUser rows stop appearing once SessionArchive exists for
  // them. Null = still live/current.
  archivedSessionId String?
  archivedAt        DateTime?

  @@index([archivedSessionId])
}

// One answer to one question on one response: a 1-5 rating PLUS its own
// required open-text follow-up (e.g. "what should we change next time?"),
// so a low rating always comes with an explanation instead of landing in
// one generic catch-all comment box. questionId points at the question
// that existed when this was answered; labelSnapshot/followUpLabelSnapshot
// freeze that question's wording at that moment, so historical reports and
// CSV exports stay meaningful even after a question is later reworded or
// deleted.
model FeedbackAnswer {
  id                     String           @id @default(uuid())
  response               FeedbackResponse @relation(fields: [responseId], references: [id])
  responseId             String
  questionId             String
  labelSnapshot          String
  rating                 Int // 1-5
  followUpLabelSnapshot  String
  followUpText           String // required - see schema comment above

  @@index([responseId])
  @@index([questionId])
}

// The live, admin-editable list of feedback questions. Order and active
// state control what the form asks right now; existing FeedbackAnswer rows
// are untouched by edits here (they keep their own label/followUp snapshots).
// Each question pairs a rating with its own open-text follow-up.
model FeedbackQuestion {
  id            String   @id @default(uuid())
  label         String
  followUpLabel String
  order         Int
  active        Boolean  @default(true)
  // "words" (Poor..Excellent) or "numbers" (plain 1-5) - e.g. an NPS-style
  // "would you recommend this" question reads better as a number.
  ratingStyle   String   @default("words")
  createdAt     DateTime @default(now())
}

// Single-row session settings:
// 1) "Give Feedback" stays greyed out for everyone until an admin turns it
//    on (e.g. near the end of a session).
// 2) currentTeam is the ONE place a team name gets typed, by the admin -
//    not re-typed by every dev. Every feedback submission is tagged with
//    this value server-side, and "Reset Everything" pre-fills its archive
//    prompt from it, so the same name is used everywhere without retyping.
model FeedbackToggle {
  id          Int     @id @default(1)
  enabled     Boolean @default(false)
  currentTeam String?
}
