// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ChallengeLock {
  id        String @id
  locked    Boolean
}

model LeaderboardUser {
  id        String @id @default(uuid())
  name      String @unique
  avatar    String
  score     Int
  updatedAt DateTime @default(now()) @updatedAt
}

model ChallengeSubmission {
  id        String   @id @default(uuid())
  userName  String
  challengeId String
  selectedLines String // stores JSON array as string
  correct   Boolean
  createdAt DateTime @default(now())
}

model FlagSubmission {
  id          String   @id @default(uuid())
  userName    String
  challengeId String
  flag        String
  correct     Boolean
  createdAt   DateTime @default(now())
}

// A frozen snapshot of the leaderboard, taken right before "Reset Everything"
// wipes it. Lets each product team's session results be kept and exported
// (CSV) even after the next team's session resets the live leaderboard.
model SessionArchive {
  id         String   @id @default(uuid())
  sessionId  String   // groups the rows taken in one archive call together
  teamName   String
  archivedAt DateTime @default(now())
  userName   String
  avatar     String
  score      Int

  @@index([sessionId])
}

// Submitted by devs themselves via the "Give Feedback" button, any time -
// not gated on finishing every lab. teamName is free text they type, same
// as the admin types when archiving a session, so results can be
// cross-referenced by eye (team + rough date) in the Analytics tab.
// teamName stays nullable in the DB (so older rows are never invalidated by
// a schema change), but the API and UI both require it on every new submission.
// Question set matches last year's full training survey, 1-5 each.
model FeedbackResponse {
  id                     String   @id @default(uuid())
  userName               String
  teamName               String?
  overall                Int // Overall, how was this session?
  relevantToRole         Int // Relevant to my role
  objectivesClear        Int // Objectives were clear
  realWorld              Int // Real-world applicable
  trainerEngaging        Int // Trainer was engaging
  interactiveQA          Int // Interactive / Q&A
  paceAndStructure       Int // Pace and structure
  materialsClear         Int // Materials were clear
  supplementaryResources Int // Supplementary resources
  materialQuality        Int // Material quality
  practicalSkills        Int // Practical skills gained
  realExamplesUsed       Int // Real examples were used
  moreConfident          Int // I feel more confident spotting this myself now
  comments               String?
  createdAt              DateTime @default(now())
}

// Single-row switch: the "Give Feedback" button stays greyed out for
// everyone until an admin turns it on (e.g. near the end of a session).
model FeedbackToggle {
  id      Int     @id @default(1)
  enabled Boolean @default(false)
}
