// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ChallengeLock {
  id        String @id
  locked    Boolean
}

model LeaderboardUser {
  id        String @id @default(uuid())
  name      String @unique
  avatar    String
  score     Int
  // Set at login time (from the dropdown populated by SessionTeam), not
  // typed free-text - so with more than 2 teams, feedback can be tagged
  // from each person's own login instead of one admin-wide "current team"
  // switch. Nullable only for rows created before this existed.
  teamName  String?
  updatedAt DateTime @default(now()) @updatedAt
}

// The admin-managed list of team names offered in the login dropdown, so
// everyone picks a team instead of typing (and misspelling) their own.
// Populate this before a session; the public /api/session-teams endpoint
// just reads it back for the login screen.
model SessionTeam {
  id        String   @id @default(uuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ChallengeSubmission {
  id        String   @id @default(uuid())
  userName  String
  challengeId String
  selectedLines String // stores JSON array as string
  correct   Boolean
  createdAt DateTime @default(now())
}

model FlagSubmission {
  id          String   @id @default(uuid())
  userName    String
  challengeId String
  flag        String
  correct     Boolean
  createdAt   DateTime @default(now())
  // Which flag-input box this came from, for a challenge with more than one
  // independent flag. Lets submit-flag tell "re-submitting my own already-
  // correct box" (harmless) apart from "pasting a flag another box already
  // used into this one" (should not count as this box being solved too).
  // Null for single-flag challenges / pre-existing rows.
  flagIndex   Int?
}

// A frozen snapshot of the leaderboard, taken right before "Reset Everything"
// wipes it. Lets each product team's session results be kept and exported
// (CSV) even after the next team's session resets the live leaderboard.
model SessionArchive {
  id         String   @id @default(uuid())
  sessionId  String   // groups the rows taken in one archive call together
  teamName   String
  archivedAt DateTime @default(now())
  userName   String
  avatar     String
  score      Int

  @@index([sessionId])
}

// Submitted by devs themselves via the "Give Feedback" button, any time -
// not gated on finishing every lab. teamName is derived server-side from
// the submitter's own LeaderboardUser.teamName (set at login), not typed
// by the dev at feedback time. (Formerly derived from the single admin-wide
// FeedbackToggle.currentTeam - replaced because that only supports one
// team being "live" at a time.)
// Ratings live in FeedbackAnswer (one row per question answered), NOT as
// fixed columns here - so questions can be added/removed/reworded via the
// admin UI with no further schema changes, ever.
model FeedbackResponse {
  id                String           @id @default(uuid())
  userName          String
  teamName          String?
  comments          String?
  createdAt         DateTime         @default(now())
  answers           FeedbackAnswer[]
  // Set together with the leaderboard's SessionArchive.sessionId, by the
  // same "Archive + Reset" action, so a response stops showing in the live
  // Dev Feedback panel once its session is archived, the same way
  // LeaderboardUser rows stop appearing once SessionArchive exists for
  // them. Null = still live/current.
  archivedSessionId String?
  archivedAt        DateTime?

  @@index([archivedSessionId])
}

// One answer to one question on one response: a 1-5 rating PLUS its own
// required open-text follow-up (e.g. "what should we change next time?"),
// so a low rating always comes with an explanation instead of landing in
// one generic catch-all comment box. questionId points at the question
// that existed when this was answered; labelSnapshot/followUpLabelSnapshot
// freeze that question's wording at that moment, so historical reports and
// CSV exports stay meaningful even after a question is later reworded or
// deleted.
model FeedbackAnswer {
  id                     String           @id @default(uuid())
  response               FeedbackResponse @relation(fields: [responseId], references: [id])
  responseId             String
  questionId             String
  labelSnapshot          String
  // "rating" (1-5 + follow-up, the original/default shape) or "choice"
  // (pick one of the question's fixed options) - snapshotted per answer so
  // a question's type can change later without corrupting old rows.
  questionType           String           @default("rating")
  rating                 Int? // 1-5, rating questions only
  followUpLabelSnapshot  String?
  followUpText           String? // required for rating questions - enforced in /api/feedback
  selectedOption         String? // choice questions only

  @@index([responseId])
  @@index([questionId])
}

// The live, admin-editable list of feedback questions. Order and active
// state control what the form asks right now; existing FeedbackAnswer rows
// are untouched by edits here (they keep their own label/followUp snapshots).
// Two shapes: "rating" pairs a 1-5 rating with its own open-text follow-up;
// "choice" asks the dev to pick one of a fixed set of options (e.g. "which
// vulnerability do you understand best?" -> SQLi/XSS/IDOR/...).
model FeedbackQuestion {
  id            String   @id @default(uuid())
  label         String
  followUpLabel String? // rating questions only
  order         Int
  active        Boolean  @default(true)
  // "words" (Poor..Excellent) or "numbers" (plain 1-5) - e.g. an NPS-style
  // "would you recommend this" question reads better as a number.
  ratingStyle   String   @default("words")
  // "rating" or "choice" - see FeedbackAnswer comment above.
  questionType  String   @default("rating")
  options       String? // JSON array of option strings, "choice" questions only
  createdAt     DateTime @default(now())
}

// Single-row session settings:
// 1) "Give Feedback" stays greyed out for everyone until an admin turns it
//    on (e.g. near the end of a session).
// 2) currentTeam is kept only as the default label the "Reset Everything"
//    archive prompt pre-fills from - it no longer tags feedback submissions
//    (see FeedbackResponse comment above). Deprecated for that purpose.
model FeedbackToggle {
  id          Int     @id @default(1)
  enabled     Boolean @default(false)
  currentTeam String?
}
